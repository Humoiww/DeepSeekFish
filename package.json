{
  "name": "deepseekfish",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local QQ bot with budgeted DeepSeek and locally approved Codex jobs",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "build": "node scripts/prepare-tokenizer.mjs && tsc -p tsconfig.json",
    "test": "npm run build && node --test --test-isolation=none dist/tests/*.test.js",
    "start": "node dist/src/cli.js start",
    "mock": "node dist/src/cli.js start --mock",
    "cli": "node dist/src/cli.js",
    "demo": "node dist/src/cli.js demo",
    "webui": "node dist/src/cli.js webui",
    "webui:mock": "node dist/src/cli.js webui --mock",
    "doctor": "node dist/src/cli.js doctor",
    "bind": "node dist/src/cli.js bind"
  },
  "dependencies": {
    "@huggingface/tokenizers": "0.2.0",
    "@openai/codex": "0.164.0",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "htmlparser2": "12.0.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "6.0.3"
  }
}
