{
  "name": "deepseekfish", "version": "0.1.0", "private": true, "type": "module",
  "description": "Local QQ bot with budgeted DeepSeek and locally approved Codex jobs",
  "engines": { "node": ">=24.9.0" },
  "scripts": {
    "build": "tsc -p tsconfig.json", "test": "tsc -p tsconfig.json && node --test --test-isolation=none dist/tests/*.test.js",
    "start": "node dist/src/cli.js start", "mock": "node dist/src/cli.js start --mock",
    "cli": "node dist/src/cli.js", "demo": "node dist/src/cli.js demo",
    "doctor": "node dist/src/cli.js doctor", "bind": "node dist/src/cli.js bind"
  },
  "dependencies": {
    "@tencent-connect/qqbot-nodejs": "1.0.5",
    "@tencent-connect/qqbot-connector": "1.2.0",
    "@openai/codex": "0.164.0"
  },
  "devDependencies": { "typescript": "6.0.3", "@types/node": "24.10.1" }
}
