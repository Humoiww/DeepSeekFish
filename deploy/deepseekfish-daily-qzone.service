[Unit]
Description=DeepSeekFish daily Qzone diary (Hong Kong time)
After=network-online.target deepseekfish-web.service deepseekfish-napcat.service
Wants=network-online.target deepseekfish-web.service
StartLimitIntervalSec=60
StartLimitBurst=5
ConditionPathExists=/srv/deepseekfish/app/runtime/data/onebot-credentials.json

[Service]
Type=oneshot
User=deepseekfish
Group=deepseekfish
WorkingDirectory=/srv/deepseekfish/app
Environment=HOME=/srv/deepseekfish
Environment=TZ=Asia/Hong_Kong
Environment=PATH=/srv/deepseekfish/app/runtime/tools/node/bin:/usr/bin:/bin
Environment=NODE_OPTIONS=--max-old-space-size=192
# QQ chat may speak automatically; it cannot authorize ordinary Codex execution.
Environment=FISH_CODEX_IMAGE_ONLY=1
UnsetEnvironment=OPENAI_API_KEY SSH_AUTH_SOCK SSH_AGENT_PID CODEX_HOME
ExecStart=/srv/deepseekfish/app/runtime/tools/node/bin/node /srv/deepseekfish/app/dist/src/cli.js daily-qzone run
TimeoutStartSec=40min
TimeoutStopSec=180
KillMode=control-group
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictNamespaces=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/srv/deepseekfish/app/runtime/data /srv/deepseekfish/app/runtime/logs /srv/deepseekfish/app/runtime/cache /srv/deepseekfish/app/runtime/tmp /srv/deepseekfish/app/runtime/workspace /srv/deepseekfish/app/runtime/outputs /srv/deepseekfish/app/runtime/memory
InaccessiblePaths=/srv/deepseekfish/app/node_modules/@openai /srv/deepseekfish/app/runtime/codex-home -/srv/deepseekfish/app/runtime/data/webui-admin-token -/srv/deepseekfish/app/runtime/data/webui.sqlite -/srv/deepseekfish/app/runtime/data/webui.sqlite-wal -/srv/deepseekfish/app/runtime/data/webui.sqlite-shm
NoExecPaths=/
ExecPaths=/srv/deepseekfish/app/runtime/tools/node/bin/node /usr/lib /lib /srv/deepseekfish/app/node_modules/@img
MemoryHigh=256M
MemoryMax=384M
CPUQuota=100%
TasksMax=128
LimitNOFILE=1024
StandardOutput=journal
StandardError=journal
