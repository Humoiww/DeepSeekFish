[Unit]
Description=Prepare the daily Qzone image and publish at midnight in Hong Kong

[Timer]
OnCalendar=*-*-* 23:50:00 Asia/Hong_Kong
OnCalendar=*-*-* 00:00:00 Asia/Hong_Kong
# Bounded recovery checks: confirmed posts skip, uncertain posts are only read back.
OnCalendar=*-*-* 00:05:00 Asia/Hong_Kong
OnCalendar=*-*-* 00:15:00 Asia/Hong_Kong
AccuracySec=1s
RandomizedDelaySec=0
Persistent=true
Unit=deepseekfish-daily-qzone.service

[Install]
WantedBy=timers.target
